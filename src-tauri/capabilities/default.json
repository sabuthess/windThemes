{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "reg",
          "cmd": "reg.exe",
          "args": true
        },
        {
          "name": "taskkill",
          "cmd": "taskkill.exe",
          "args": true
        },
        {
          "name": "explorer.exe",
          "cmd": "explorer.exe",
          "args": true
        },
        { "name": "binaries/ligh_mode", "sidecar": true },
        { "name": "binaries/dark_mode", "sidecar": true }
      ]
    }
  ]
}
